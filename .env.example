# ============================================================
# DLavie OS / NEXUS_OS — Environment Variables
# ============================================================
# Copy this file to .env and fill in your tokens.
# All secrets are optional — the app runs fine without them.
#
# How to use:
#   1. Copy: cp .env.example .env
#   2. Fill in the tokens you want to enable
#   3. Restart the API server workflow
# ============================================================

# --------------------------------------------------
# 1. HuggingFace (HF_TOKEN) — Cloud LLM fallback
# --------------------------------------------------
# Get your token at: https://huggingface.co/settings/tokens
# Used for: chat fallback when Ollama is down, model hub browsing,
#           HF dataset access for auto-training
# Without this: app falls back to Ollama (local) and rule-based training
# HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --------------------------------------------------
# 2. GitHub Token (GITHUB_TOKEN) — Repo access, model cards
# --------------------------------------------------
# Get your token at: https://github.com/settings/tokens
# Used for: fetching model READMEs from GitHub, trending repos
# Without this: public repos still work (no rate limit)
# GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --------------------------------------------------
# 3. API Key (NEXUS_API_KEY) — Protected API endpoints
# --------------------------------------------------
# Set any random string here to protect /api/v1/* and /api/models/* endpoints
# Without this: endpoints are wide open (dev-only)
# NEXUS_API_KEY=your-secret-key-here

# --------------------------------------------------
# 4. Ollama Configuration (optional)
# --------------------------------------------------
# Ollama is auto-started by the server; only change if you run your own
# OLLAMA_HOST=http://127.0.0.1:11434
# OLLAMA_PATH=/usr/local/bin/ollama
# OLLAMA_MODELS=/home/user/.ollama/models

# --------------------------------------------------
# 5. Auto-Training Intervals (optional)
# --------------------------------------------------
# AUTO_TRAIN_INTERVAL_MS=10800000   # 3 hours (default)
# MICRO_TRAIN_INTERVAL_MS=60000     # 60 seconds (default)

# --------------------------------------------------
# 6. Logging (optional)
# --------------------------------------------------
# LOG_LEVEL=info

# --------------------------------------------------
# 7. Puter.js / Cloud AI (optional)
# --------------------------------------------------
# If you want to use Puter.js cloud models alongside local Ollama
# PUTER_API_KEY=your-puter-api-key
